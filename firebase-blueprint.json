{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "UserProfile": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "createdAt", "updatedAt"],
      "additionalProperties": false
    },
    "GalleryFolder": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 50 },
        "color": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "createdAt", "updatedAt"],
      "additionalProperties": false
    },
    "GalleryPhoto": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 800000 },
        "thumbnailUrl": { "type": "string", "maxLength": 200000 },
        "folderId": { "type": "string", "maxLength": 128 },
        "favorite": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "maxLength": 30 },
          "maxItems": 10
        },
        "prompt": { "type": "string", "maxLength": 1000 },
        "presetName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "imageUrl", "favorite", "createdAt", "updatedAt"],
      "additionalProperties": false
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile containing account preferences and details."
    },
    "/users/{userId}/folders/{folderId}": {
      "schema": { "$ref": "#/entities/GalleryFolder" },
      "description": "Organized folders/albums created by the user to organize saved photos."
    },
    "/users/{userId}/photos/{photoId}": {
      "schema": { "$ref": "#/entities/GalleryPhoto" },
      "description": "Edited photos saved to personal gallery with settings, category, and tags."
    }
  }
}
