rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.id == userId
        && data.id == request.auth.uid
        && data.email is string
        && data.email.size() <= 256
        && data.displayName is string
        && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFolder(data, userId) {
      return data.id is string
        && isValidId(data.id)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 50
        && (!('color' in data) || (data.color is string && data.color.size() <= 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhoto(data, userId) {
      return data.id is string
        && isValidId(data.id)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.imageUrl is string
        && data.imageUrl.size() <= 800000
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 200000))
        && (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 128))
        && data.favorite is bool
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
        && (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 1000))
        && (!('presetName' in data) || (data.presetName is string && data.presetName.size() <= 100))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // PII Guard: Listing all user profiles is strictly disallowed

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'updatedAt']);

      allow delete: if false; // Account deletion guarded

      // Folders Subcollection
      match /folders/{folderId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(folderId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(folderId)
          && isValidFolder(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(folderId)
          && isValidFolder(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(folderId);
      }

      // Photos Subcollection (Personal Gallery)
      match /photos/{photoId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(photoId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(photoId)
          && isValidPhoto(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(photoId)
          && isValidPhoto(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'favorite', 'folderId', 'tags', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(photoId);
      }
    }
  }
}
